{
  "name": "taskuary-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo --outDir ../site/demo --base=./",
    "build:docs": "node tools/build-docs.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:browser:voice": "node --test browser/builtin-voice-card.test.mjs",
    "test:browser": "node --test --test-concurrency=1 browser/loads-once.test.mjs browser/general-starting.test.mjs browser/continue-shows-turn.test.mjs browser/run-another-general.test.mjs browser/task-agent-handoff.test.mjs",
    "test:browser:i18n": "node --test --test-concurrency=1 browser/interface-settings.test.mjs browser/localized-action-guard.test.mjs browser/workflow-schedule.test.mjs",
    "test:browser:features": "node --test --test-concurrency=1 browser/first-run-task-cli.test.mjs browser/jira-data-center.test.mjs browser/jira-agent-trust.test.mjs browser/skills-library.test.mjs browser/held-repo-pick.test.mjs browser/back-board-hub.test.mjs",
    "check:deadends": "node deadend_check.mjs",
    "lint:undef": "eslint -c eslint.undef.mjs src/*.jsx src/*.js"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.17",
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^6.1.0",
    "@mui/material": "^6.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.7.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "marked": "^18.0.13",
    "puppeteer-core": "^25.8.0",
    "vite": "^6.4.3"
  }
}
